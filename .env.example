JWT_ISSUER=
JWT_SECRET=
JWT_TTL_SECONDS=
POSTGRES_USER=
POSTGRES_PASSWORD=
ELASTICSEARCH_USER=
ELASTICSEARCH_PASSWORD=
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=
SLACK_ALERTS_ENABLED=
GRAFANA_ADMIN_PASSWORD=
ENVIRONMENT=
# Application Configuration
APP_BASE_URL=

# Mail Configuration (Gmail 예시)
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
SUPPORT_EMAIL=

# 공공 데이터 포탈
DATA_GO_KR_API_KEY=
COMMONDATA_INTERNAL_API_KEY=
KRX_API_KEY=

# 네이버 개발자 센터
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# dummy local value for E2E routing verification (no real Toss calls made)
TOSS_SECRET_KEY=

# dart api key
DART_API_KEY=

# 한국은행 ECOS Open API 인증키 (economics-service 지표 수집용)
ECOS_API_KEY=

# OPENAI API KEY
OPENAI_API_KEY=

# Anthropic API key (LLM 감성분석, ADR 0023 Phase 4) — 로컬 전용, gitignore. 노출 시 rotate.
ANTHROPIC_API_KEY=

# Google Gemini API key (LLM 감성분석 provider=gemini, ADR 0023 Phase 4) — 로컬 전용, gitignore. 노출 시 rotate.
# ai-service 의 RAG 임베딩(gemini-embedding-001)도 같은 키를 쓴다.
GEMINI_API_KEY=

# ── AI 챗봇 LLM provider ──
# gemini(기본) | anthropic | deepseek — ai-service 어댑터가 정확히 하나만 등록된다.
APP_AI_PROVIDER=gemini

# DeepSeek API key (provider=deepseek, OpenAI 호환 Chat Completions) — 로컬 전용, gitignore. 노출 시 rotate.
DEEPSEEK_API_KEY=
# 원격 DeepSeek 대신 로컬 Ollama 로 돌리려면 아래 두 줄을 바꾸고 키에 아무 문자열이나 넣는다
# (Ollama 는 키를 검사하지 않지만, 비어 있으면 "미구성"으로 판정돼 채팅이 503 이 된다):
#   APP_AI_DEEPSEEK_BASE_URL=http://localhost:11434/v1   (compose 안에서는 http://host.docker.internal:11434/v1)
#   APP_AI_DEEPSEEK_MODEL=deepseek-r1:7b
APP_AI_DEEPSEEK_MODEL=deepseek-chat
APP_AI_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ── AI 챗봇 RAG (ADR 0034) ──
# true 로 켜면 ai-service 부팅 시 마이그레이션이 pgvector 확장을 설치하고 지식베이스 API 가 열린다.
# 켠 뒤 지식을 넣는 방법: python3 scripts/knowledge/sync_knowledge.py --dry-run  (docs/knowledge/ 참고)
# 지식베이스가 비어 있으면 켜도 답변은 달라지지 않는다 — 근거가 0건이면 Phase 1 과 같은 경로를 탄다.
APP_AI_RAG_ENABLED=false

# xAI Grok Build CLI (grok) — 터미널 코딩 에이전트. 미설정 시 grok login 브라우저 인증으로 폴백
XAI_API_KEY=
