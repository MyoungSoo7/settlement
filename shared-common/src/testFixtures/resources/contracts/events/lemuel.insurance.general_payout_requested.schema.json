{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "lemuel.insurance.general_payout_requested",
  "description": "insurance-service → settlement/account. 해지환급금·만기금 지급 요청. 산출 근거(경과월·적용률·납입보험료 합계)를 함께 싣는다 — 금액만 오면 지급 심사가 원장을 다시 계산해야 한다.",
  "type": "object",
  "properties": {
    "policyNumber": {
      "type": "string"
    },
    "payoutId": {
      "type": "string"
    },
    "payoutType": {
      "type": "string"
    },
    "amount": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "paidPremiumTotal": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "appliedRate": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "elapsedMonths": {
      "type": "integer"
    },
    "installmentCount": {
      "type": "integer"
    },
    "requestedOn": {
      "type": "string"
    },
    "fcId": {
      "type": "string"
    }
  },
  "required": [
    "policyNumber",
    "payoutId",
    "payoutType",
    "amount",
    "paidPremiumTotal",
    "appliedRate",
    "elapsedMonths",
    "requestedOn"
  ],
  "additionalProperties": true
}
