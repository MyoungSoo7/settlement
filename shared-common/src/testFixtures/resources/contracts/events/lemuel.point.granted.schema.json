{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "lemuel.point.granted",
  "description": "order-service(point) → account-service. 보너스·구매적립·수기지급. GL: DR POINT_PROMOTION_EXPENSE / CR POINT_LIABILITY (회사가 비용으로 얹은 몫). expiresAt 이 null 이면 무기한 로트다.",
  "type": "object",
  "properties": {
    "userId": {
      "type": "integer"
    },
    "accountId": {
      "type": "integer"
    },
    "amount": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "occurredAt": {
      "type": "string"
    },
    "lotId": {
      "type": "integer"
    },
    "origin": {
      "type": "string",
      "enum": [
        "CHARGE_BONUS",
        "ORDER_EARN",
        "MANUAL_GRANT",
        "REFUND_RESTORE"
      ]
    },
    "referenceType": {
      "type": "string"
    },
    "referenceId": {
      "type": "string"
    },
    "expiresAt": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "userId",
    "accountId",
    "lotId",
    "amount",
    "origin"
  ],
  "additionalProperties": true
}
