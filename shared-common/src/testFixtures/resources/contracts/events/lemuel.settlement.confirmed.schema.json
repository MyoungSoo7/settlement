{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "lemuel.settlement.confirmed",
  "description": "정산이 확정된 사실. amount 는 확정 정산금으로 JSON string(BigDecimal.toPlainString, DATA-STANDARD N5).",
  "type": "object",
  "properties": {
    "settlementId": { "type": "integer" },
    "sellerId": { "type": "integer" },
    "amount": { "type": "string", "pattern": "^-?[0-9]+(\\.[0-9]+)?$" }
  },
  "required": ["settlementId", "sellerId", "amount"],
  "additionalProperties": true
}
