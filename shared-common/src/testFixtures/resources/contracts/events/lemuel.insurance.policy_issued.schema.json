{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "lemuel.insurance.policy_issued",
  "description": "insurance-service → loan/investment. 계약 발행. 보장금액을 실어 신용보강 관점에서 소비된다. 파티션 키는 policyNumber — 한 계약의 발행·상태변경·수수료가 같은 파티션에 순서대로 떨어져야 소비자가 일관된 상태를 본다. 금액은 plain string(DATA-STANDARD N5).",
  "type": "object",
  "properties": {
    "policyNumber": {
      "type": "string"
    },
    "fcId": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "effectiveDate": {
      "type": "string"
    },
    "maturityDate": {
      "type": "string"
    },
    "premiumAmount": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "coverageAmount": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "salesChannel": {
      "type": "string"
    },
    "partnerBankCode": {
      "type": "string"
    }
  },
  "required": [
    "policyNumber",
    "fcId",
    "status",
    "effectiveDate",
    "premiumAmount",
    "coverageAmount",
    "salesChannel"
  ],
  "additionalProperties": true
}
