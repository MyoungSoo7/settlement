{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "lemuel.insurance.commission_clawback_triggered",
  "description": "insurance-service → settlement/account. 계약이 종단 상태에 도달해 기지급 수수료를 환수한다(24개월 창구). paidTotal 과 clawbackAmount 를 함께 싣는다 — 환수액만 오면 소비자가 \"전액인가 일부인가\"를 알 수 없다.",
  "type": "object",
  "properties": {
    "policyNumber": {
      "type": "string"
    },
    "fcId": {
      "type": "string"
    },
    "terminalStatus": {
      "type": "string"
    },
    "effectiveDate": {
      "type": "string"
    },
    "paidTotal": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "clawbackAmount": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    }
  },
  "required": [
    "policyNumber",
    "fcId",
    "terminalStatus",
    "paidTotal",
    "clawbackAmount"
  ],
  "additionalProperties": true
}
