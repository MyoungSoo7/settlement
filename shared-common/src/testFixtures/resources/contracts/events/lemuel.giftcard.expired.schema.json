{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "lemuel.giftcard.expired",
  "description": "order-service(giftcard) → account-service. 유효기간 소멸(낙전). GL: DR GIFT_CARD_LIABILITY / CR GIFT_CARD_BREAKAGE_INCOME — 소멸이익 인식. amount 는 소멸한 잔액이며 remainingAmount 는 소멸 후 값(0)이다.",
  "type": "object",
  "properties": {
    "giftCardId": {
      "type": "integer"
    },
    "userId": {
      "type": "integer"
    },
    "codeLast4": {
      "type": "string"
    },
    "remainingAmount": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "amount": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "occurredAt": {
      "type": "string"
    }
  },
  "required": [
    "giftCardId",
    "amount"
  ],
  "additionalProperties": true
}
